# Copy this file to local.properties (it is git-ignored) and fill in your values.
# sdk.dir is added automatically by Android Studio.

# Emulator -> your PC:      http://10.0.2.2:5000/api/
# Real phone -> your PC:    http://<your-PC-LAN-IP>:5000/api/   (same Wi-Fi)
# Deployed backend:         https://your-app.onrender.com/api/
# NOTE: must end with a slash.
planner.baseUrl=http://10.0.2.2:5000/api/

# The *Web application* OAuth client ID from Google Cloud Console
# (the same value as GOOGLE_WEB_CLIENT_ID in backend/.env)
planner.googleWebClientId=xxxxxxxx.apps.googleusercontent.com
