# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/planner

# Google "Web application" OAuth client ID (the Android app sends ID tokens issued for this audience)
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=5000
# Optional: comma-separated origins allowed by CORS (only needed if you keep a web client)
CORS_ORIGINS=

# Optional: reading timetables from PDFs and photos (Excel and CSV work without it).
# Create a key at console.anthropic.com. Keep it secret; add it only in Render's Environment tab.
ANTHROPIC_API_KEY=
# Optional: which model to use (defaults to a built-in choice)
ANTHROPIC_MODEL=

